* {
  bg: #011627;
  bg-alt: #1d3b53;
  bg-selected: #82aaff;

    primary: #5F7E97;

  fg: #d6deeb;
  fg-alt: #7f849c;

  
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 35%;
  background-color: @bg;
	border: 1;
	border-color: @primary;
}

element {
  padding: 8 12;
  background-color: transparent;
  text-color: @fg-alt;
}

element selected {
  text-color: @fg;
	background-color: @primary;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

element-icon {
  size: 14;
  padding: 0 10 0 0;
  background-color: transparent;
}

entry {
  padding: 12;
  text-color: @fg;
	background-color: transparent;
}

inputbar {
  children: [prompt, entry];
  background-color: transparent;
	border: 0 0 1 0;
	margin: 0 0 4 0;
	border-color: @primary;
	
}

listview {
  background-color: @bg;
  columns: 1;
  lines: 10;
  padding: 10;
}

mainbox {
  children: [inputbar, listview];
  background-color: @bg;
}

prompt {
  enabled: true;
  padding: 12 0 0 12;
  background-color: transparent;
  text-color: @fg;
}

