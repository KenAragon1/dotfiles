#!/bin/sh

send_notification() {
	percentage=$(pamixer --get-volume)

	icon="$HOME/.local/share/icons/dunst/volume.svg"
	dunstify -a "changevolume" -u low -r 9991 -h int:value:"$percentage" -i $icon "Volume $percentage%" -t 5000
}

case $1 in
	up)
		pamixer -i 2
        # pkill -RTMIN+10 i3blocks
		send_notification
		;;
	down)
		pamixer -d 2
        # pkill -RTMIN+10 i3blocks
		send_notification
		;;
esac

