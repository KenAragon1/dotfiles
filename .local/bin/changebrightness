#!/bin/sh

send_notification() {
	current=$(brightnessctl g)
	max=$(brightnessctl m)
	percentage=$(( current * 100 / max ))

	icon="$HOME/.local/share/icons/dunst/brightness.svg"
	dunstify -a "changebrightness" -u low -r 9991 -h int:value:"$percentage" -i $icon "Brightness $percentage%" -t 5000
}

case $1 in
	up)
		brightnessctl set +1%
		send_notification
		;;
	down)
		brightnessctl set 1%-
		send_notification
		;;
esac

